# Example environment values only. Do not place real secrets here.

# Frontend
# Leave empty to infer the API from the current browser host.
# Example: opening http://100.x.y.z:4321/app will call http://100.x.y.z:3000.
PUBLIC_API_BASE_URL=

# Backend
NODE_ENV=development
PORT=3000
# Multiple origins can be separated by commas.
CORS_ORIGIN=http://localhost:4321

# MongoDB
# Use different database names for development and production.
# Copy this value to apps/api/.env with real credentials.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=song_repertoire_dev
