---
const repertoireItems = [
  { order: "01", title: "Cancion de entrada", category: "Inicio" },
  { order: "02", title: "Tema congregacional", category: "Celebracion" },
  { order: "03", title: "Momento de adoracion", category: "Adoracion" }
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Panel local inicial para gestionar repertorios musicales."
    />
    <title>App local | Song Repertoire</title>
  </head>
  <body>
    <main class="layout">
      <aside class="sidebar" aria-label="Navegacion de la aplicacion">
        <a class="brand" href="/">Song Repertoire</a>
        <nav>
          <a aria-current="page" href="/app">Repertorios</a>
          <a href="/app">Canciones</a>
          <a href="/app">Categorias</a>
        </nav>
      </aside>

      <section class="content" aria-labelledby="page-title">
        <header>
          <div>
            <p class="eyebrow">App local</p>
            <h1 id="page-title">Repertorio activo</h1>
          </div>
          <button type="button">Nuevo repertorio</button>
        </header>

        <div class="workspace">
          <section class="queue" aria-label="Orden del repertorio">
            {
              repertoireItems.map((item) => (
                <article>
                  <span>{item.order}</span>
                  <div>
                    <h2>{item.title}</h2>
                    <p>{item.category}</p>
                  </div>
                </article>
              ))
            }
          </section>

          <aside class="summary" aria-label="Resumen">
            <h2>Resumen</h2>
            <dl>
              <div>
                <dt>Canciones</dt>
                <dd>3</dd>
              </div>
              <div>
                <dt>Estado</dt>
                <dd>Borrador local</dd>
              </div>
              <div>
                <dt>Login</dt>
                <dd>No implementado</dd>
              </div>
            </dl>
          </aside>
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  :root {
    color: #17202e;
    background: #eef2f6;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  body {
    min-width: 320px;
    margin: 0;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .layout {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
  }

  .sidebar {
    border-right: 1px solid #d4dbe5;
    background: #17202e;
    color: #ffffff;
    padding: 24px;
  }

  .brand {
    display: block;
    margin-bottom: 32px;
    font-size: 1rem;
    font-weight: 850;
  }

  nav {
    display: grid;
    gap: 8px;
  }

  nav a {
    border-radius: 8px;
    padding: 11px 12px;
    color: #dfe5ed;
    font-weight: 720;
  }

  nav a[aria-current="page"] {
    background: #ffffff;
    color: #17202e;
  }

  .content {
    padding: clamp(20px, 4vw, 44px);
  }

  header {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    align-items: flex-start;
    margin-bottom: 24px;
  }

  .eyebrow {
    margin: 0 0 8px;
    color: #b24d3d;
    font-size: 0.76rem;
    font-weight: 850;
    text-transform: uppercase;
  }

  h1,
  h2,
  p {
    margin-top: 0;
  }

  h1 {
    margin-bottom: 0;
    font-size: clamp(2rem, 5vw, 3.4rem);
    line-height: 1;
    letter-spacing: 0;
  }

  button {
    min-height: 42px;
    border: 0;
    border-radius: 8px;
    background: #b24d3d;
    color: #ffffff;
    padding: 11px 16px;
    font: inherit;
    font-weight: 800;
  }

  .workspace {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: 16px;
  }

  .queue {
    display: grid;
    gap: 10px;
  }

  article,
  .summary {
    border: 1px solid #d5dce5;
    border-radius: 8px;
    background: #ffffff;
  }

  article {
    min-height: 86px;
    display: grid;
    grid-template-columns: 54px minmax(0, 1fr);
    align-items: center;
    gap: 16px;
    padding: 16px;
  }

  article span {
    color: #b24d3d;
    font-weight: 850;
  }

  article h2 {
    margin-bottom: 6px;
    font-size: 1.12rem;
  }

  article p {
    margin-bottom: 0;
    color: #647386;
  }

  .summary {
    align-self: start;
    padding: 18px;
  }

  .summary h2 {
    margin-bottom: 16px;
    font-size: 1rem;
  }

  dl,
  dd {
    margin: 0;
  }

  dl {
    display: grid;
    gap: 14px;
  }

  dt {
    margin-bottom: 4px;
    color: #647386;
    font-size: 0.82rem;
    font-weight: 750;
  }

  dd {
    font-weight: 820;
  }

  @media (max-width: 760px) {
    .layout,
    .workspace {
      grid-template-columns: 1fr;
    }

    .sidebar {
      border-right: 0;
      padding: 18px;
    }

    nav {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    nav a {
      text-align: center;
    }

    header {
      flex-direction: column;
    }
  }
</style>
