---
const configuredApiBaseUrl = import.meta.env.PUBLIC_API_BASE_URL ?? "";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Panel local para crear repertorios y administrar canciones."
    />
    <title>App local | Song Repertoire</title>
  </head>
  <body>
    <main class="layout" data-api-base-url={configuredApiBaseUrl}>
      <aside class="sidebar" aria-label="Navegacion de la aplicacion">
        <a class="brand" href="/">Song Repertoire</a>
        <nav>
          <a aria-current="page" href="/app">Repertorios</a>
          <a href="/app">Canciones</a>
          <a href="/app">Categorias</a>
        </nav>
      </aside>

      <section class="content" aria-labelledby="page-title">
        <header class="page-header">
          <div>
            <p class="eyebrow">App local</p>
            <h1 id="page-title">Dashboard de repertorios</h1>
          </div>
          <p id="connection-status" class="status" role="status">Conectando</p>
        </header>

        <div class="workspace">
          <section class="panel repertoire-list-panel" aria-labelledby="repertoires-title">
            <div class="panel-heading dashboard-heading">
              <div>
                <p class="panel-kicker">Gestion local</p>
                <h2 id="repertoires-title">Repertorios</h2>
              </div>
              <button id="new-repertoire-button" class="primary-button" type="button">
                Nuevo repertorio
              </button>
            </div>

            <div class="dashboard-metrics" aria-label="Resumen de repertorios">
              <div>
                <strong id="repertoire-count">0</strong>
                <span>repertorios</span>
              </div>
              <div>
                <strong id="dashboard-song-count">0</strong>
                <span>canciones</span>
              </div>
            </div>

            <label class="search-field">
              Buscar
              <input
                id="repertoire-search"
                autocomplete="off"
                placeholder="Nombre o descripcion"
                type="search"
              />
            </label>

            <div id="repertoire-list" class="repertoire-list" aria-live="polite"></div>
          </section>

          <section class="panel builder" aria-labelledby="builder-title">
            <div class="panel-heading">
              <h2 id="builder-title">Nuevo repertorio</h2>
              <span id="selected-count">0 canciones</span>
            </div>

            <form id="repertoire-form" class="form-grid">
              <label>
                Nombre
                <input
                  id="repertoire-name"
                  name="name"
                  maxlength="120"
                  minlength="2"
                  required
                  type="text"
                />
              </label>

              <label>
                Descripcion
                <textarea
                  id="repertoire-description"
                  maxlength="240"
                  name="description"
                  rows="3"></textarea>
              </label>

              <fieldset class="tag-builder">
                <legend>Etiquetas internas</legend>
                <div class="tag-form-row">
                  <label>
                    Nombre
                    <input
                      id="repertoire-tag-name"
                      maxlength="40"
                      minlength="2"
                      placeholder="Entrada, cierre..."
                      type="text"
                    />
                  </label>
                  <label>
                    Color
                    <select id="repertoire-tag-color">
                      <option value="slate">Gris</option>
                      <option value="red">Rojo</option>
                      <option value="amber">Ambar</option>
                      <option value="green">Verde</option>
                      <option value="blue">Azul</option>
                      <option value="purple">Morado</option>
                    </select>
                  </label>
                  <button id="add-repertoire-tag" class="ghost-button" type="button">
                    Agregar etiqueta
                  </button>
                </div>
                <div id="repertoire-tags" class="tag-list" aria-live="polite"></div>
              </fieldset>

              <div class="selected-list" id="selected-songs" aria-live="polite"></div>

              <div class="form-actions">
                <button id="repertoire-submit-button" class="primary-button" type="submit">
                  Crear repertorio
                </button>
                <button id="cancel-repertoire-edit" class="ghost-button is-hidden" type="button">
                  Cancelar edicion
                </button>
              </div>
            </form>
          </section>

          <section class="panel song-picker" aria-labelledby="songs-title">
            <div class="panel-heading dashboard-heading">
              <div>
                <p class="panel-kicker">Biblioteca</p>
                <h2 id="songs-title">Canciones</h2>
              </div>
              <button id="refresh-button" class="icon-button" type="button" title="Actualizar">
                Actualizar
              </button>
            </div>

            <div class="song-tools">
              <label class="search-field">
                Buscar
                <input
                  id="song-search"
                  autocomplete="off"
                  placeholder="Titulo o letra"
                  type="search"
                />
              </label>

              <label class="filter-field">
                Categoria
                <select id="song-category-filter">
                  <option value="">Todas</option>
                  <option value="__uncategorized">Sin categoria</option>
                </select>
              </label>

              <label class="checkbox-row filter-checkbox">
                <input id="song-available-only" type="checkbox" />
                Solo disponibles
              </label>
            </div>

            <p id="song-filter-count" class="list-meta">0 canciones</p>
            <div id="song-list" class="song-list" aria-live="polite"></div>
          </section>

          <section class="panel quick-song" aria-labelledby="quick-song-title">
            <h2 id="quick-song-title">Crear cancion</h2>
            <form id="song-form" class="form-grid">
              <label>
                Titulo
                <input
                  id="song-title"
                  maxlength="140"
                  minlength="2"
                  name="title"
                  required
                  type="text"
                />
              </label>
              <label>
                Letra
                <textarea
                  id="song-lyrics"
                  maxlength="20000"
                  name="lyrics"
                  required
                  rows="7"></textarea>
              </label>
              <fieldset class="category-picker">
                <legend>Categorias</legend>
                <div id="song-category-options" class="category-options" aria-live="polite"></div>
              </fieldset>
              <label id="add-created-song-row" class="checkbox-row">
                <input id="add-created-song" type="checkbox" checked />
                Agregar al repertorio
              </label>
              <div class="form-actions">
                <button id="song-submit-button" class="secondary-button" type="submit">
                  Guardar cancion
                </button>
                <button id="cancel-song-edit" class="ghost-button is-hidden" type="button">
                  Cancelar edicion
                </button>
              </div>
            </form>
          </section>

          <section class="panel category-panel" aria-labelledby="categories-title">
            <div class="panel-heading">
              <h2 id="categories-title">Categorias</h2>
              <span id="category-count">0</span>
            </div>
            <form id="category-form" class="form-grid">
              <label>
                Nombre
                <input
                  id="category-name"
                  maxlength="80"
                  minlength="2"
                  name="name"
                  required
                  type="text"
                />
              </label>
              <label>
                Descripcion
                <textarea
                  id="category-description"
                  maxlength="240"
                  name="description"
                  rows="3"></textarea>
              </label>
              <div class="form-actions">
                <button id="category-submit-button" class="secondary-button" type="submit">
                  Guardar categoria
                </button>
                <button id="cancel-category-edit" class="ghost-button is-hidden" type="button">
                  Cancelar edicion
                </button>
              </div>
            </form>
            <div id="category-list" class="category-list" aria-live="polite"></div>
          </section>

        </div>

        <p id="feedback" class="feedback" role="status"></p>
      </section>
    </main>

    <script>
      const root = document.querySelector(".layout");
      const configuredApiBaseUrl = root?.dataset.apiBaseUrl ?? "";
      const apiBaseUrl = resolveApiBaseUrl(configuredApiBaseUrl);

      const state = {
        categories: [],
        editingCategoryId: null,
        editingRepertoireId: null,
        editingSongId: null,
        pendingDelete: null,
        repertoireTags: [],
        repertoireSearchTerm: "",
        showAvailableSongsOnly: false,
        songCategoryFilter: "",
        songSearchTerm: "",
        songs: [],
        repertoires: [],
        selectedSongs: []
      };

      const elements = {
        addCreatedSong: document.querySelector("#add-created-song"),
        addRepertoireTag: document.querySelector("#add-repertoire-tag"),
        addCreatedSongRow: document.querySelector("#add-created-song-row"),
        builderTitle: document.querySelector("#builder-title"),
        cancelCategoryEdit: document.querySelector("#cancel-category-edit"),
        cancelRepertoireEdit: document.querySelector("#cancel-repertoire-edit"),
        cancelSongEdit: document.querySelector("#cancel-song-edit"),
        categoryCount: document.querySelector("#category-count"),
        categoryDescription: document.querySelector("#category-description"),
        categoryForm: document.querySelector("#category-form"),
        categoryList: document.querySelector("#category-list"),
        categoryName: document.querySelector("#category-name"),
        categorySubmitButton: document.querySelector("#category-submit-button"),
        connectionStatus: document.querySelector("#connection-status"),
        dashboardSongCount: document.querySelector("#dashboard-song-count"),
        feedback: document.querySelector("#feedback"),
        newRepertoireButton: document.querySelector("#new-repertoire-button"),
        quickSongTitle: document.querySelector("#quick-song-title"),
        refreshButton: document.querySelector("#refresh-button"),
        repertoireCount: document.querySelector("#repertoire-count"),
        repertoireDescription: document.querySelector("#repertoire-description"),
        repertoireForm: document.querySelector("#repertoire-form"),
        repertoireList: document.querySelector("#repertoire-list"),
        repertoireName: document.querySelector("#repertoire-name"),
        repertoireSearch: document.querySelector("#repertoire-search"),
        repertoireTagColor: document.querySelector("#repertoire-tag-color"),
        repertoireTagList: document.querySelector("#repertoire-tags"),
        repertoireTagName: document.querySelector("#repertoire-tag-name"),
        repertoireSubmitButton: document.querySelector("#repertoire-submit-button"),
        selectedCount: document.querySelector("#selected-count"),
        selectedSongs: document.querySelector("#selected-songs"),
        songAvailableOnly: document.querySelector("#song-available-only"),
        songCategoryFilter: document.querySelector("#song-category-filter"),
        songCategoryOptions: document.querySelector("#song-category-options"),
        songFilterCount: document.querySelector("#song-filter-count"),
        songForm: document.querySelector("#song-form"),
        songList: document.querySelector("#song-list"),
        songLyrics: document.querySelector("#song-lyrics"),
        songSearch: document.querySelector("#song-search"),
        songSubmitButton: document.querySelector("#song-submit-button"),
        songTitle: document.querySelector("#song-title")
      };

      function escapeHtml(value) {
        return String(value)
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#039;");
      }

      function showFeedback(message, type = "neutral") {
        if (!elements.feedback) return;
        elements.feedback.textContent = message;
        elements.feedback.dataset.type = type;
      }

      function updateFormModes() {
        if (elements.builderTitle) {
          elements.builderTitle.textContent = state.editingRepertoireId
            ? "Editar repertorio"
            : "Nuevo repertorio";
        }
        if (elements.repertoireSubmitButton) {
          elements.repertoireSubmitButton.textContent = state.editingRepertoireId
            ? "Actualizar repertorio"
            : "Crear repertorio";
        }
        elements.cancelRepertoireEdit?.classList.toggle("is-hidden", !state.editingRepertoireId);

        if (elements.quickSongTitle) {
          elements.quickSongTitle.textContent = state.editingSongId
            ? "Editar cancion"
            : "Crear cancion";
        }
        if (elements.songSubmitButton) {
          elements.songSubmitButton.textContent = state.editingSongId
            ? "Actualizar cancion"
            : "Guardar cancion";
        }
        elements.cancelSongEdit?.classList.toggle("is-hidden", !state.editingSongId);
        elements.addCreatedSongRow?.classList.toggle("is-hidden", Boolean(state.editingSongId));
        if (elements.addCreatedSong) {
          elements.addCreatedSong.disabled = Boolean(state.editingSongId);
        }

        if (elements.categorySubmitButton) {
          elements.categorySubmitButton.textContent = state.editingCategoryId
            ? "Actualizar categoria"
            : "Guardar categoria";
        }
        elements.cancelCategoryEdit?.classList.toggle("is-hidden", !state.editingCategoryId);
      }

      function isLoopbackHost(hostname) {
        return ["localhost", "127.0.0.1", "::1", "[::1]"].includes(hostname);
      }

      function resolveApiBaseUrl(configuredUrl) {
        const fallbackUrl = `${window.location.protocol}//${window.location.hostname}:3000`;
        const trimmedUrl = configuredUrl.trim();

        if (trimmedUrl.length === 0) {
          return fallbackUrl;
        }

        try {
          const url = new URL(trimmedUrl);

          if (isLoopbackHost(url.hostname) && !isLoopbackHost(window.location.hostname)) {
            url.hostname = window.location.hostname;
          }

          return url.origin;
        } catch {
          return trimmedUrl;
        }
      }

      async function apiRequest(path, options = {}) {
        const response = await fetch(`${apiBaseUrl}${path}`, {
          headers: {
            "Content-Type": "application/json",
            ...(options.headers ?? {})
          },
          ...options
        });

        if (!response.ok) {
          const body = await response.json().catch(() => ({}));
          const message = Array.isArray(body.message)
            ? body.message.join(", ")
            : body.message || `HTTP ${response.status}`;
          throw new Error(message);
        }

        return response.json();
      }

      function getSongTitle(songId) {
        return state.songs.find((song) => song._id === songId)?.title ?? "Cancion";
      }

      function getRepertoireSongId(song) {
        return String(song?.songId?._id ?? song?.songId ?? "");
      }

      function normalizeRepertoireSongs(songs = []) {
        return [...songs]
          .sort((a, b) => Number(a.order ?? 0) - Number(b.order ?? 0))
          .map((song, index) => ({
            songId: getRepertoireSongId(song),
            order: index + 1,
            tagIds: Array.isArray(song.tagIds) ? song.tagIds.map((id) => String(id)) : []
          }))
          .filter((song) => song.songId.length > 0);
      }

      function normalizeRepertoireTags(tags = []) {
        return tags
          .map((tag) => ({
            color: getTagColor(tag.color),
            name: String(tag.name ?? "").trim(),
            tagId: String(tag.tagId ?? "").trim()
          }))
          .filter((tag) => tag.tagId.length > 0 && tag.name.length > 0);
      }

      function getTagColor(color) {
        return ["slate", "red", "amber", "green", "blue", "purple"].includes(color)
          ? color
          : "slate";
      }

      function createTagId() {
        if (window.crypto?.randomUUID) {
          return window.crypto.randomUUID();
        }

        return `tag-${Date.now()}-${Math.random().toString(16).slice(2)}`;
      }

      function getRepertoireTag(tagId) {
        return state.repertoireTags.find((tag) => tag.tagId === tagId);
      }

      function getCategoryNames(categoryIds = []) {
        const ids = new Set(categoryIds.map((id) => String(id)));
        return state.categories
          .filter((category) => ids.has(String(category._id)))
          .map((category) => category.name);
      }

      function getSongCategoryIds(song) {
        return (song.categoryIds ?? []).map((id) => String(id));
      }

      function isSongSelected(songId) {
        return state.selectedSongs.some((song) => song.songId === songId);
      }

      function setSongCategorySelection(categoryIds = []) {
        const ids = new Set(categoryIds.map((id) => String(id)));
        document.querySelectorAll('input[name="song-category"]').forEach((input) => {
          input.checked = ids.has(input.value);
        });
      }

      function renderDeleteControls(type, id) {
        const escapedType = escapeHtml(type);
        const escapedId = escapeHtml(id);
        const isPending = state.pendingDelete?.type === type && state.pendingDelete?.id === id;

        if (isPending) {
          return `
            <button class="danger-button" type="button" data-confirm-delete-type="${escapedType}" data-confirm-delete-id="${escapedId}">Confirmar</button>
            <button class="ghost-button" type="button" data-cancel-delete="true">Cancelar</button>
          `;
        }

        return `<button class="danger-button" type="button" data-request-delete-type="${escapedType}" data-request-delete-id="${escapedId}">Eliminar</button>`;
      }

      function renderCrudLists() {
        renderCategories();
        renderSongs();
        renderRepertoires();
      }

      function setPendingDelete(type, id) {
        state.pendingDelete = { type, id };
        renderCrudLists();
      }

      function clearPendingDelete() {
        state.pendingDelete = null;
        renderCrudLists();
      }

      function handleDeleteIntent(target, expectedType) {
        const requestDeleteId = target.dataset.requestDeleteId;
        if (requestDeleteId && target.dataset.requestDeleteType === expectedType) {
          setPendingDelete(expectedType, requestDeleteId);
          return true;
        }

        if (target.dataset.cancelDelete) {
          clearPendingDelete();
          return true;
        }

        const confirmDeleteId = target.dataset.confirmDeleteId;
        if (confirmDeleteId && target.dataset.confirmDeleteType === expectedType) {
          if (expectedType === "category") void deleteCategory(confirmDeleteId);
          if (expectedType === "song") void deleteSong(confirmDeleteId);
          if (expectedType === "repertoire") void deleteRepertoire(confirmDeleteId);
          return true;
        }

        return false;
      }

      function resetCategoryForm() {
        state.editingCategoryId = null;
        elements.categoryForm?.reset();
        updateFormModes();
      }

      function resetSongForm() {
        state.editingSongId = null;
        elements.songForm?.reset();
        if (elements.addCreatedSong) elements.addCreatedSong.checked = true;
        setSongCategorySelection([]);
        updateFormModes();
      }

      function resetRepertoireForm() {
        state.editingRepertoireId = null;
        state.repertoireTags = [];
        state.selectedSongs = [];
        elements.repertoireForm?.reset();
        renderRepertoireTags();
        renderSelectedSongs();
        renderSongs();
        updateFormModes();
        renderRepertoires();
      }

      function startEditCategory(categoryId) {
        const category = state.categories.find((item) => item._id === categoryId);
        if (!category) return;

        state.editingCategoryId = categoryId;
        if (elements.categoryName) elements.categoryName.value = category.name ?? "";
        if (elements.categoryDescription) {
          elements.categoryDescription.value = category.description ?? "";
        }
        updateFormModes();
        elements.categoryName?.focus();
      }

      function startEditSong(songId) {
        const song = state.songs.find((item) => item._id === songId);
        if (!song) return;

        state.editingSongId = songId;
        if (elements.songTitle) elements.songTitle.value = song.title ?? "";
        if (elements.songLyrics) elements.songLyrics.value = song.lyrics ?? "";
        setSongCategorySelection(song.categoryIds ?? []);
        updateFormModes();
        elements.songTitle?.focus();
      }

      function startEditRepertoire(repertoireId) {
        const repertoire = state.repertoires.find((item) => item._id === repertoireId);
        if (!repertoire) return;

        state.editingRepertoireId = repertoireId;
        state.repertoireTags = normalizeRepertoireTags(repertoire.tags ?? []);
        state.selectedSongs = normalizeRepertoireSongs(repertoire.songs ?? []);
        if (elements.repertoireName) elements.repertoireName.value = repertoire.name ?? "";
        if (elements.repertoireDescription) {
          elements.repertoireDescription.value = repertoire.description ?? "";
        }
        renderRepertoireTags();
        renderSelectedSongs();
        renderSongs();
        updateFormModes();
        renderRepertoires();
        elements.repertoireName?.focus();
      }

      function addSongToRepertoire(songId) {
        if (state.selectedSongs.some((song) => song.songId === songId)) {
          showFeedback("La cancion ya esta en el repertorio.", "warning");
          return;
        }

        state.selectedSongs.push({
          songId,
          order: state.selectedSongs.length + 1,
          tagIds: []
        });
        renderSelectedSongs();
        renderSongs();
      }

      function removeSelectedSong(songId) {
        state.selectedSongs = state.selectedSongs
          .filter((song) => song.songId !== songId)
          .map((song, index) => ({ ...song, order: index + 1 }));
        renderSelectedSongs();
        renderSongs();
      }

      function moveSelectedSong(songId, direction) {
        const index = state.selectedSongs.findIndex((song) => song.songId === songId);
        const nextIndex = index + direction;

        if (index < 0 || nextIndex < 0 || nextIndex >= state.selectedSongs.length) {
          return;
        }

        const nextSongs = [...state.selectedSongs];
        const current = nextSongs[index];
        nextSongs[index] = nextSongs[nextIndex];
        nextSongs[nextIndex] = current;
        state.selectedSongs = nextSongs.map((song, songIndex) => ({
          ...song,
          order: songIndex + 1
        }));
        renderSelectedSongs();
      }

      function addRepertoireTag() {
        const name = elements.repertoireTagName?.value.trim() ?? "";
        const color = getTagColor(elements.repertoireTagColor?.value ?? "slate");

        if (name.length < 2) {
          showFeedback("La etiqueta necesita al menos 2 caracteres.", "warning");
          elements.repertoireTagName?.focus();
          return;
        }

        const exists = state.repertoireTags.some(
          (tag) => tag.name.toLocaleLowerCase() === name.toLocaleLowerCase()
        );

        if (exists) {
          showFeedback("Esa etiqueta ya existe en este repertorio.", "warning");
          elements.repertoireTagName?.focus();
          return;
        }

        state.repertoireTags.push({
          color,
          name,
          tagId: createTagId()
        });

        if (elements.repertoireTagName) elements.repertoireTagName.value = "";
        if (elements.repertoireTagColor) elements.repertoireTagColor.value = "slate";
        renderRepertoireTags();
        renderSelectedSongs();
        showFeedback("Etiqueta agregada al repertorio.", "ok");
      }

      function removeRepertoireTag(tagId) {
        state.repertoireTags = state.repertoireTags.filter((tag) => tag.tagId !== tagId);
        state.selectedSongs = state.selectedSongs.map((song) => ({
          ...song,
          tagIds: (song.tagIds ?? []).filter((id) => id !== tagId)
        }));
        renderRepertoireTags();
        renderSelectedSongs();
      }

      function toggleSelectedSongTag(songId, tagId, checked) {
        state.selectedSongs = state.selectedSongs.map((song) => {
          if (song.songId !== songId) return song;

          const tagIds = new Set(song.tagIds ?? []);

          if (checked) {
            tagIds.add(tagId);
          } else {
            tagIds.delete(tagId);
          }

          return {
            ...song,
            tagIds: [...tagIds]
          };
        });
        renderSelectedSongs();
      }

      function renderRepertoireTags() {
        if (!elements.repertoireTagList) return;

        if (state.repertoireTags.length === 0) {
          elements.repertoireTagList.innerHTML = '<p class="empty">Sin etiquetas internas.</p>';
          return;
        }

        elements.repertoireTagList.innerHTML = state.repertoireTags
          .map(
            (tag) => `
              <span class="tag-chip tag-${escapeHtml(tag.color)}">
                ${escapeHtml(tag.name)}
                <button type="button" data-remove-repertoire-tag="${escapeHtml(tag.tagId)}">Quitar</button>
              </span>
            `
          )
          .join("");
      }

      function renderTagChips(tagIds = []) {
        return tagIds
          .map((tagId) => getRepertoireTag(tagId))
          .filter(Boolean)
          .map(
            (tag) =>
              `<span class="tag-chip tag-${escapeHtml(tag.color)}">${escapeHtml(tag.name)}</span>`
          )
          .join("");
      }

      function renderRepertoireTagChips(tags = []) {
        const normalizedTags = normalizeRepertoireTags(tags);

        if (normalizedTags.length === 0) return "";

        return `
          <div class="song-card-tags">
            ${normalizedTags
              .map(
                (tag) =>
                  `<span class="tag-chip tag-${escapeHtml(tag.color)}">${escapeHtml(tag.name)}</span>`
              )
              .join("")}
          </div>
        `;
      }

      function renderSelectedSongTagControls(song) {
        if (state.repertoireTags.length === 0) {
          return '<p class="empty selected-tag-empty">Sin etiquetas internas para asignar.</p>';
        }

        const currentTagIds = new Set(song.tagIds ?? []);

        return `
          <div class="selected-tag-controls">
            ${state.repertoireTags
              .map(
                (tag) => `
                  <label class="tag-option tag-${escapeHtml(tag.color)}">
                    <input
                      data-song-tag-id="${escapeHtml(tag.tagId)}"
                      data-song-tag-song-id="${escapeHtml(song.songId)}"
                      type="checkbox"
                      ${currentTagIds.has(tag.tagId) ? "checked" : ""}
                    />
                    <span>${escapeHtml(tag.name)}</span>
                  </label>
                `
              )
              .join("")}
          </div>
        `;
      }

      function renderSongCategoryFilter() {
        if (!elements.songCategoryFilter) return;

        const currentFilter = state.songCategoryFilter;
        const filterIsValid =
          currentFilter.length === 0 ||
          currentFilter === "__uncategorized" ||
          state.categories.some((category) => String(category._id) === currentFilter);

        if (!filterIsValid) {
          state.songCategoryFilter = "";
        }

        elements.songCategoryFilter.innerHTML = `
          <option value="">Todas</option>
          <option value="__uncategorized">Sin categoria</option>
          ${state.categories
            .map(
              (category) =>
                `<option value="${escapeHtml(category._id)}">${escapeHtml(category.name)}</option>`
            )
            .join("")}
        `;
        elements.songCategoryFilter.value = state.songCategoryFilter;
      }

      function getFilteredSongs() {
        const query = state.songSearchTerm.trim().toLocaleLowerCase();

        return state.songs.filter((song) => {
          const categoryIds = getSongCategoryIds(song);
          const matchesQuery =
            query.length === 0 ||
            `${song.title ?? ""} ${song.lyrics ?? ""}`.toLocaleLowerCase().includes(query);
          const matchesCategory =
            state.songCategoryFilter.length === 0 ||
            (state.songCategoryFilter === "__uncategorized" && categoryIds.length === 0) ||
            categoryIds.includes(state.songCategoryFilter);
          const matchesAvailability =
            !state.showAvailableSongsOnly || !isSongSelected(String(song._id));

          return matchesQuery && matchesCategory && matchesAvailability;
        });
      }

      function renderSongs() {
        if (!elements.songList) return;

        if (elements.songFilterCount) {
          elements.songFilterCount.textContent = `${state.songs.length} canciones`;
        }

        if (state.songs.length === 0) {
          elements.songList.innerHTML = '<p class="empty">Sin canciones todavia.</p>';
          return;
        }

        const filteredSongs = getFilteredSongs();

        if (elements.songFilterCount) {
          elements.songFilterCount.textContent = `${filteredSongs.length} de ${state.songs.length} canciones`;
        }

        if (filteredSongs.length === 0) {
          elements.songList.innerHTML = '<p class="empty">Sin canciones con ese filtro.</p>';
          return;
        }

        elements.songList.innerHTML = filteredSongs
          .map((song) => {
            const categoryNames = getCategoryNames(song.categoryIds ?? []);
            const categoryText = categoryNames.length > 0 ? categoryNames.join(", ") : "Sin categoria";
            const isSelected = isSongSelected(String(song._id));
            const lyricsPreview = (song.lyrics ?? "").slice(0, 116);

            return `
              <article class="song-row song-card${isSelected ? " is-selected" : ""}">
                <div>
                  <h3>${escapeHtml(song.title)}</h3>
                  <p>${escapeHtml(lyricsPreview)}</p>
                  <small>${escapeHtml(categoryText)}</small>
                </div>
                <div class="row-actions">
                  <button class="${isSelected ? "ghost-button" : "secondary-button"}" type="button" data-add-song="${escapeHtml(song._id)}" ${isSelected ? "disabled" : ""}>${isSelected ? "Agregada" : "Agregar"}</button>
                  <button class="ghost-button" type="button" data-edit-song="${escapeHtml(song._id)}">Editar</button>
                  ${renderDeleteControls("song", song._id)}
                </div>
              </article>
            `;
          })
          .join("");
      }

      function renderCategories() {
        if (elements.categoryCount) {
          elements.categoryCount.textContent = String(state.categories.length);
        }

        renderSongCategoryFilter();

        if (elements.categoryList) {
          elements.categoryList.innerHTML =
            state.categories.length === 0
              ? '<p class="empty">Sin categorias todavia.</p>'
              : state.categories
                  .map(
                    (category) => `
                      <article class="category-row">
                        <div>
                          <h3>${escapeHtml(category.name)}</h3>
                          <p>${escapeHtml(category.description || "Sin descripcion")}</p>
                        </div>
                        <div class="row-actions">
                          <button class="ghost-button" type="button" data-edit-category="${escapeHtml(category._id)}">Editar</button>
                          ${renderDeleteControls("category", category._id)}
                        </div>
                      </article>
                    `
                  )
                  .join("");
        }

        if (elements.songCategoryOptions) {
          elements.songCategoryOptions.innerHTML =
            state.categories.length === 0
              ? '<p class="empty">Sin categorias.</p>'
              : state.categories
                  .map(
                    (category) => `
                      <label class="category-option">
                        <input name="song-category" type="checkbox" value="${escapeHtml(category._id)}" />
                        <span>${escapeHtml(category.name)}</span>
                      </label>
                    `
                  )
                  .join("");

          const editingSong = state.songs.find((song) => song._id === state.editingSongId);
          if (editingSong) {
            setSongCategorySelection(editingSong.categoryIds ?? []);
          }
        }
      }

      function renderSelectedSongs() {
        if (!elements.selectedSongs || !elements.selectedCount) return;

        elements.selectedCount.textContent = `${state.selectedSongs.length} canciones`;

        if (state.selectedSongs.length === 0) {
          elements.selectedSongs.innerHTML = '<p class="empty">Sin canciones seleccionadas.</p>';
          return;
        }

        elements.selectedSongs.innerHTML = state.selectedSongs
          .map(
            (song) => `
              <article class="selected-song">
                <span>${String(song.order).padStart(2, "0")}</span>
                <div class="selected-song-main">
                  <strong>${escapeHtml(getSongTitle(song.songId))}</strong>
                  <div class="song-card-tags">${renderTagChips(song.tagIds ?? [])}</div>
                  ${renderSelectedSongTagControls(song)}
                </div>
                <div class="selected-song-actions">
                  <button type="button" data-move-song="${escapeHtml(song.songId)}" data-direction="-1">Subir</button>
                  <button type="button" data-move-song="${escapeHtml(song.songId)}" data-direction="1">Bajar</button>
                  <button type="button" data-remove-song="${escapeHtml(song.songId)}">Quitar</button>
                </div>
              </article>
            `
          )
          .join("");
      }

      function replaceById(items, nextItem) {
        return items.map((item) => (item._id === nextItem._id ? nextItem : item));
      }

      function sortByName(items) {
        return items.sort((a, b) => String(a.name ?? "").localeCompare(String(b.name ?? "")));
      }

      function sortByTitle(items) {
        return items.sort((a, b) => String(a.title ?? "").localeCompare(String(b.title ?? "")));
      }

      function renderDashboardMetrics() {
        if (elements.repertoireCount) {
          elements.repertoireCount.textContent = String(state.repertoires.length);
        }

        if (elements.dashboardSongCount) {
          elements.dashboardSongCount.textContent = String(state.songs.length);
        }
      }

      function renderRepertoires() {
        if (!elements.repertoireList || !elements.repertoireCount) return;
        renderDashboardMetrics();

        if (state.repertoires.length === 0) {
          elements.repertoireList.innerHTML = '<p class="empty">Sin repertorios todavia.</p>';
          return;
        }

        const query = state.repertoireSearchTerm.trim().toLocaleLowerCase();
        const repertoires = query
          ? state.repertoires.filter((repertoire) =>
              `${repertoire.name ?? ""} ${repertoire.description ?? ""} ${(repertoire.tags ?? [])
                .map((tag) => tag.name)
                .join(" ")}`
                .toLocaleLowerCase()
                .includes(query)
            )
          : state.repertoires;

        if (repertoires.length === 0) {
          elements.repertoireList.innerHTML = '<p class="empty">Sin repertorios con ese filtro.</p>';
          return;
        }

        elements.repertoireList.innerHTML = repertoires
          .map(
            (repertoire) => {
              const isActive = state.editingRepertoireId === repertoire._id;
              const songCount = normalizeRepertoireSongs(repertoire.songs ?? []).length;
              const tagCount = normalizeRepertoireTags(repertoire.tags ?? []).length;

              return `
              <article class="repertoire-row repertoire-card${isActive ? " is-active" : ""}" ${isActive ? 'aria-current="true"' : ""}>
                <div>
                  <h3>${escapeHtml(repertoire.name)}</h3>
                  <p>${escapeHtml(repertoire.description || "Sin descripcion")}</p>
                  ${renderRepertoireTagChips(repertoire.tags ?? [])}
                </div>
                <div class="row-actions">
                  <span>${songCount} canciones</span>
                  <span>${tagCount} etiquetas</span>
                  <button class="${isActive ? "ghost-button" : "secondary-button"}" type="button" data-edit-repertoire="${escapeHtml(repertoire._id)}">${isActive ? "Abierto" : "Abrir"}</button>
                  ${renderDeleteControls("repertoire", repertoire._id)}
                </div>
              </article>
            `;
            }
          )
          .join("");
      }

      async function loadData() {
        try {
          const [health, songs, repertoires, categories] = await Promise.all([
            apiRequest("/health"),
            apiRequest("/songs"),
            apiRequest("/repertoires"),
            apiRequest("/categories")
          ]);

          state.categories = categories;
          state.songs = songs;
          state.repertoires = repertoires;

          if (elements.connectionStatus) {
            elements.connectionStatus.textContent =
              health.database === "connected" ? "Atlas conectado" : "API conectada";
            elements.connectionStatus.dataset.type = "ok";
          }

          renderCategories();
          renderRepertoireTags();
          renderSongs();
          renderSelectedSongs();
          renderRepertoires();
        } catch (error) {
          if (elements.connectionStatus) {
            elements.connectionStatus.textContent = "API no disponible";
            elements.connectionStatus.dataset.type = "error";
          }
          showFeedback(error instanceof Error ? error.message : "No se pudo cargar la API.", "error");
        }
      }

      elements.songList?.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof HTMLElement)) return;

        if (handleDeleteIntent(target, "song")) return;

        const editSongId = target.dataset.editSong;
        if (editSongId) {
          startEditSong(editSongId);
          return;
        }

        const songId = target.dataset.addSong;
        if (songId) addSongToRepertoire(songId);
      });

      elements.categoryList?.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof HTMLElement)) return;

        if (handleDeleteIntent(target, "category")) return;

        const editCategoryId = target.dataset.editCategory;
        if (editCategoryId) {
          startEditCategory(editCategoryId);
        }
      });

      elements.repertoireList?.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof HTMLElement)) return;

        if (handleDeleteIntent(target, "repertoire")) return;

        const editRepertoireId = target.dataset.editRepertoire;
        if (editRepertoireId) {
          startEditRepertoire(editRepertoireId);
        }
      });

      elements.repertoireTagList?.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof HTMLElement)) return;

        const tagId = target.dataset.removeRepertoireTag;
        if (tagId) {
          removeRepertoireTag(tagId);
        }
      });

      elements.selectedSongs?.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof HTMLElement)) return;

        const removeSongId = target.dataset.removeSong;
        if (removeSongId) {
          removeSelectedSong(removeSongId);
          return;
        }

        const moveSongId = target.dataset.moveSong;
        const direction = Number(target.dataset.direction ?? 0);
        if (moveSongId && direction !== 0) {
          moveSelectedSong(moveSongId, direction);
        }
      });

      elements.selectedSongs?.addEventListener("change", (event) => {
        const target = event.target;
        if (!(target instanceof HTMLInputElement)) return;

        const tagId = target.dataset.songTagId;
        const songId = target.dataset.songTagSongId;

        if (tagId && songId) {
          toggleSelectedSongTag(songId, tagId, target.checked);
        }
      });

      elements.refreshButton?.addEventListener("click", () => {
        void loadData();
      });

      elements.addRepertoireTag?.addEventListener("click", () => {
        addRepertoireTag();
      });

      elements.newRepertoireButton?.addEventListener("click", () => {
        resetRepertoireForm();
        showFeedback("Listo para crear un repertorio.", "ok");
        elements.repertoireName?.focus();
      });

      elements.repertoireSearch?.addEventListener("input", () => {
        state.repertoireSearchTerm = elements.repertoireSearch?.value ?? "";
        renderRepertoires();
      });

      elements.songSearch?.addEventListener("input", () => {
        state.songSearchTerm = elements.songSearch?.value ?? "";
        renderSongs();
      });

      elements.songCategoryFilter?.addEventListener("change", () => {
        state.songCategoryFilter = elements.songCategoryFilter?.value ?? "";
        renderSongs();
      });

      elements.songAvailableOnly?.addEventListener("change", () => {
        state.showAvailableSongsOnly = Boolean(elements.songAvailableOnly?.checked);
        renderSongs();
      });

      elements.cancelCategoryEdit?.addEventListener("click", () => {
        resetCategoryForm();
      });

      elements.cancelSongEdit?.addEventListener("click", () => {
        resetSongForm();
      });

      elements.cancelRepertoireEdit?.addEventListener("click", () => {
        resetRepertoireForm();
      });

      async function deleteCategory(categoryId) {
        const category = state.categories.find((item) => item._id === categoryId);
        if (!category) return;

        try {
          await apiRequest(`/categories/${categoryId}`, { method: "DELETE" });
          state.pendingDelete = null;
          state.categories = state.categories.filter((item) => item._id !== categoryId);
          state.songs = state.songs.map((song) => ({
            ...song,
            categoryIds: (song.categoryIds ?? []).filter((id) => String(id) !== categoryId)
          }));
          if (state.editingCategoryId === categoryId) resetCategoryForm();
          renderCategories();
          renderSongs();
          showFeedback("Categoria eliminada.", "ok");
        } catch (error) {
          showFeedback(error instanceof Error ? error.message : "No se pudo eliminar la categoria.", "error");
        }
      }

      async function deleteSong(songId) {
        const song = state.songs.find((item) => item._id === songId);
        if (!song) return;

        try {
          await apiRequest(`/songs/${songId}`, { method: "DELETE" });
          state.pendingDelete = null;
          state.songs = state.songs.filter((item) => item._id !== songId);
          state.selectedSongs = state.selectedSongs
            .filter((item) => item.songId !== songId)
            .map((item, index) => ({ ...item, order: index + 1 }));
          if (state.editingSongId === songId) resetSongForm();
          renderSongs();
          renderSelectedSongs();
          renderRepertoires();
          showFeedback("Cancion eliminada.", "ok");
        } catch (error) {
          showFeedback(error instanceof Error ? error.message : "No se pudo eliminar la cancion.", "error");
        }
      }

      async function deleteRepertoire(repertoireId) {
        const repertoire = state.repertoires.find((item) => item._id === repertoireId);
        if (!repertoire) return;

        try {
          await apiRequest(`/repertoires/${repertoireId}`, { method: "DELETE" });
          state.pendingDelete = null;
          state.repertoires = state.repertoires.filter((item) => item._id !== repertoireId);
          if (state.editingRepertoireId === repertoireId) resetRepertoireForm();
          renderRepertoires();
          showFeedback("Repertorio eliminado.", "ok");
        } catch (error) {
          showFeedback(error instanceof Error ? error.message : "No se pudo eliminar el repertorio.", "error");
        }
      }

      elements.categoryForm?.addEventListener("submit", async (event) => {
        event.preventDefault();

        try {
          const payload = {
            description: elements.categoryDescription?.value || undefined,
            name: elements.categoryName?.value ?? ""
          };
          const category = await apiRequest(
            state.editingCategoryId ? `/categories/${state.editingCategoryId}` : "/categories",
            {
              body: JSON.stringify(payload),
              method: state.editingCategoryId ? "PATCH" : "POST"
            }
          );
          const wasEditing = Boolean(state.editingCategoryId);

          state.categories = wasEditing
            ? replaceById(state.categories, category)
            : [...state.categories, category];
          sortByName(state.categories);
          resetCategoryForm();
          renderCategories();
          renderSongs();
          showFeedback(wasEditing ? "Categoria actualizada." : "Categoria guardada.", "ok");
        } catch (error) {
          showFeedback(error instanceof Error ? error.message : "No se pudo guardar la categoria.", "error");
        }
      });

      elements.songForm?.addEventListener("submit", async (event) => {
        event.preventDefault();

        try {
          const categoryIds = Array.from(
            document.querySelectorAll('input[name="song-category"]:checked')
          ).map((input) => input.value);

          const payload = {
            categoryIds,
            title: elements.songTitle?.value ?? "",
            lyrics: elements.songLyrics?.value ?? ""
          };
          const song = await apiRequest(
            state.editingSongId ? `/songs/${state.editingSongId}` : "/songs",
            {
              body: JSON.stringify(payload),
              method: state.editingSongId ? "PATCH" : "POST"
            }
          );
          const wasEditing = Boolean(state.editingSongId);

          state.songs = wasEditing ? replaceById(state.songs, song) : [...state.songs, song];
          sortByTitle(state.songs);
          renderSongs();
          renderRepertoires();

          if (!wasEditing && elements.addCreatedSong?.checked) {
            addSongToRepertoire(song._id);
          }

          resetSongForm();
          renderSelectedSongs();
          showFeedback(wasEditing ? "Cancion actualizada." : "Cancion guardada.", "ok");
        } catch (error) {
          showFeedback(error instanceof Error ? error.message : "No se pudo guardar la cancion.", "error");
        }
      });

      elements.repertoireForm?.addEventListener("submit", async (event) => {
        event.preventDefault();

        try {
          const payload = {
            description: elements.repertoireDescription?.value || undefined,
            name: elements.repertoireName?.value ?? "",
            tags: state.repertoireTags,
            songs: state.selectedSongs
          };
          const repertoire = await apiRequest(
            state.editingRepertoireId
              ? `/repertoires/${state.editingRepertoireId}`
              : "/repertoires",
            {
              body: JSON.stringify(payload),
              method: state.editingRepertoireId ? "PATCH" : "POST"
            }
          );
          const wasEditing = Boolean(state.editingRepertoireId);

          state.repertoires = wasEditing
            ? replaceById(state.repertoires, repertoire)
            : [...state.repertoires, repertoire];
          sortByName(state.repertoires);
          resetRepertoireForm();
          renderRepertoires();
          showFeedback(wasEditing ? "Repertorio actualizado." : "Repertorio creado.", "ok");
        } catch (error) {
          showFeedback(error instanceof Error ? error.message : "No se pudo guardar el repertorio.", "error");
        }
      });

      void loadData();
    </script>
  </body>
</html>

<style>
  :root {
    color: #182231;
    background: #eef2f6;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  body {
    min-width: 320px;
    margin: 0;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button,
  input,
  select,
  textarea {
    font: inherit;
  }

  button {
    cursor: pointer;
  }

  .layout {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
  }

  .sidebar {
    border-right: 1px solid #d4dbe5;
    background: #17202e;
    color: #ffffff;
    padding: 24px;
  }

  .brand {
    display: block;
    margin-bottom: 32px;
    font-size: 1rem;
    font-weight: 850;
  }

  nav {
    display: grid;
    gap: 8px;
  }

  nav a {
    border-radius: 8px;
    padding: 11px 12px;
    color: #dfe5ed;
    font-weight: 720;
  }

  nav a[aria-current="page"] {
    background: #ffffff;
    color: #17202e;
  }

  .content {
    padding: clamp(20px, 4vw, 40px);
  }

  .page-header,
  .panel-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
  }

  .page-header {
    margin-bottom: 22px;
  }

  .eyebrow {
    margin: 0 0 8px;
    color: #b24d3d;
    font-size: 0.76rem;
    font-weight: 850;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    margin-bottom: 0;
    font-size: clamp(2rem, 5vw, 3.4rem);
    line-height: 1;
    letter-spacing: 0;
  }

  h2 {
    margin-bottom: 0;
    font-size: 1.05rem;
  }

  h3 {
    margin-bottom: 5px;
    font-size: 0.98rem;
  }

  .panel-kicker {
    margin: 0 0 6px;
    color: #647386;
    font-size: 0.72rem;
    font-weight: 850;
    text-transform: uppercase;
  }

  .status,
  .feedback {
    min-height: 34px;
    border-radius: 8px;
    padding: 8px 12px;
    background: #ffffff;
    color: #556579;
    font-weight: 760;
  }

  .status[data-type="ok"],
  .feedback[data-type="ok"] {
    color: #14634f;
  }

  .status[data-type="error"],
  .feedback[data-type="error"] {
    color: #9d2f24;
  }

  .feedback[data-type="warning"] {
    color: #805300;
  }

  .workspace {
    display: grid;
    grid-template-columns: minmax(360px, 1.15fr) minmax(300px, 0.85fr);
    gap: 14px;
    align-items: start;
  }

  .panel {
    border: 1px solid #d5dce5;
    border-radius: 8px;
    background: #ffffff;
    padding: 18px;
  }

  .builder,
  .repertoire-list-panel {
    grid-column: 1;
  }

  .song-picker,
  .quick-song,
  .category-panel {
    grid-column: 2;
  }

  .dashboard-heading {
    align-items: center;
  }

  .dashboard-metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin-top: 16px;
  }

  .dashboard-metrics div {
    min-height: 74px;
    display: grid;
    align-content: center;
    gap: 4px;
    border: 1px solid #e3e8ef;
    border-radius: 8px;
    background: #fbfcfe;
    padding: 12px;
  }

  .dashboard-metrics strong {
    color: #17202e;
    font-size: 1.6rem;
    line-height: 1;
  }

  .dashboard-metrics span {
    color: #647386;
    font-size: 0.82rem;
    font-weight: 800;
  }

  .form-grid {
    display: grid;
    gap: 14px;
    margin-top: 16px;
  }

  label,
  legend {
    display: grid;
    gap: 7px;
    color: #39485a;
    font-size: 0.88rem;
    font-weight: 780;
  }

  fieldset {
    min-width: 0;
    border: 1px solid #e3e8ef;
    border-radius: 8px;
    padding: 12px;
  }

  legend {
    padding: 0 6px;
  }

  input,
  select,
  textarea {
    width: 100%;
    border: 1px solid #cfd7e1;
    border-radius: 8px;
    padding: 11px 12px;
    color: #182231;
    background: #fbfcfe;
  }

  textarea {
    resize: vertical;
  }

  .search-field {
    margin-top: 16px;
  }

  .song-tools {
