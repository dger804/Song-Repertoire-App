---
const highlights = [
  "Organiza canciones por categoria",
  "Prepara repertorios para ensayos y eventos",
  "Mantiene el orden de interpretacion visible"
];

const modules = ["Canciones", "Categorias", "Repertorios", "Letras"];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Song Repertoire App ayuda a organizar canciones, letras y repertorios musicales desde una aplicacion web local."
    />
    <title>Song Repertoire App</title>
  </head>
  <body>
    <header class="topbar" aria-label="Navegacion principal">
      <a class="brand" href="/">Song Repertoire</a>
      <nav>
        <a href="#modulos">Modulos</a>
        <a href="/app">Abrir app</a>
      </nav>
    </header>

    <main>
      <section class="hero" aria-labelledby="page-title">
        <div class="hero-copy">
          <p class="eyebrow">Repertorios claros, ensayos mas tranquilos</p>
          <h1 id="page-title">Tu biblioteca musical lista antes de tocar.</h1>
          <p class="lede">
            Una app local para reunir canciones, letras, categorias y repertorios
            en un flujo pensado para preparar presentaciones sin depender de hojas
            sueltas.
          </p>
          <div class="actions">
            <a class="primary-action" href="/app">Entrar a la app</a>
            <a class="secondary-action" href="#modulos">Ver modulos</a>
          </div>
        </div>

        <aside class="product-preview" aria-label="Vista previa del repertorio">
          <div class="preview-header">
            <span>Repertorio domingo</span>
            <strong>8 canciones</strong>
          </div>
          <ol>
            <li><span>01</span><strong>Abre mis ojos</strong><small>Entrada</small></li>
            <li><span>02</span><strong>Bueno es alabar</strong><small>Celebracion</small></li>
            <li><span>03</span><strong>Tu fidelidad</strong><small>Adoracion</small></li>
            <li><span>04</span><strong>Final preparado</strong><small>Cierre</small></li>
          </ol>
        </aside>
      </section>

      <section id="modulos" class="modules" aria-labelledby="modules-title">
        <div>
          <p class="eyebrow">MVP local</p>
          <h2 id="modules-title">Primero una experiencia simple para probar en casa.</h2>
        </div>

        <div class="module-grid">
          {
            modules.map((module) => (
              <article>
                <h3>{module}</h3>
                <p>Base preparada para construir el flujo del MVP sin login inicial.</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="notes" aria-label="Enfoque del proyecto">
        {
          highlights.map((highlight) => (
            <p>{highlight}</p>
          ))
        }
      </section>
    </main>
  </body>
</html>

<style>
  :root {
    color: #17202e;
    background: #f5f7fa;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  body {
    min-width: 320px;
    margin: 0;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .topbar {
    width: min(1160px, calc(100% - 32px));
    min-height: 72px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .brand {
    font-size: 1rem;
    font-weight: 800;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 18px;
    color: #4f5e70;
    font-size: 0.95rem;
    font-weight: 650;
  }

  main {
    padding-bottom: 56px;
  }

  .hero {
    width: min(1160px, calc(100% - 32px));
    min-height: calc(100vh - 120px);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.95fr);
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
    padding: 28px 0 64px;
  }

  .eyebrow {
    margin: 0 0 14px;
    color: #b24d3d;
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    max-width: 720px;
    margin-bottom: 22px;
    font-size: clamp(3rem, 8vw, 6.4rem);
    line-height: 0.95;
    letter-spacing: 0;
  }

  .lede {
    max-width: 650px;
    margin-bottom: 30px;
    color: #4a596b;
    font-size: clamp(1rem, 2vw, 1.24rem);
    line-height: 1.7;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .primary-action,
  .secondary-action {
    min-height: 46px;
    border-radius: 8px;
    padding: 13px 18px;
    font-weight: 800;
  }

  .primary-action {
    background: #17202e;
    color: #ffffff;
  }

  .secondary-action {
    border: 1px solid #cfd6df;
    background: #ffffff;
    color: #2d3848;
  }

  .product-preview {
    border: 1px solid #d5dce5;
    border-radius: 8px;
    background: #ffffff;
    box-shadow: 0 24px 70px rgb(31 42 57 / 14%);
    overflow: hidden;
  }

  .preview-header {
    min-height: 78px;
    padding: 22px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    background: #21374a;
    color: #ffffff;
  }

  .preview-header span {
    font-weight: 800;
  }

  .preview-header strong {
    color: #f4c46b;
    font-size: 0.9rem;
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 12px;
  }

  li {
    min-height: 74px;
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr);
    align-items: center;
    column-gap: 14px;
    padding: 12px;
    border-bottom: 1px solid #eef1f5;
  }

  li:last-child {
    border-bottom: 0;
  }

  li span {
    color: #b24d3d;
    font-size: 0.82rem;
    font-weight: 850;
  }

  li strong,
  li small {
    grid-column: 2;
  }

  li strong {
    color: #1e2a3a;
    line-height: 1.25;
  }

  li small {
    margin-top: 4px;
    color: #687789;
  }

  .modules {
    width: min(1160px, calc(100% - 32px));
    margin: 0 auto;
    padding: 40px 0;
    display: grid;
    grid-template-columns: minmax(240px, 0.7fr) minmax(0, 1.3fr);
    gap: 28px;
    align-items: start;
  }

  h2 {
    margin-bottom: 0;
    font-size: clamp(1.8rem, 4vw, 3.2rem);
    line-height: 1.05;
    letter-spacing: 0;
  }

  .module-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  article {
    min-height: 150px;
    border: 1px solid #d5dce5;
    border-radius: 8px;
    padding: 18px;
    background: #ffffff;
  }

  h3 {
    margin-bottom: 12px;
    font-size: 1.08rem;
  }

  article p {
    margin-bottom: 0;
    color: #5c6b7d;
    line-height: 1.55;
  }

  .notes {
    width: min(1160px, calc(100% - 32px));
    margin: 12px auto 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .notes p {
    min-height: 84px;
    margin: 0;
    border-left: 4px solid #f4c46b;
    background: #ffffff;
    padding: 18px;
    color: #374456;
    font-weight: 720;
    line-height: 1.45;
  }

  @media (max-width: 820px) {
    .hero,
    .modules,
    .notes {
      grid-template-columns: 1fr;
    }

    .hero {
      min-height: auto;
      padding-top: 44px;
    }
  }

  @media (max-width: 560px) {
    .topbar {
      align-items: flex-start;
      flex-direction: column;
      padding: 18px 0;
    }

    nav {
      width: 100%;
      justify-content: space-between;
    }

    .module-grid {
      grid-template-columns: 1fr;
    }

    .actions a {
      width: 100%;
      text-align: center;
    }
  }
</style>
