---
const plannedFeatures = [
  "Canciones",
  "Categorias",
  "Repertorios",
  "Orden de interpretacion"
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Aplicacion personal para organizar canciones, categorias y repertorios musicales."
    />
    <title>Song Repertoire App</title>
  </head>
  <body>
    <main class="app-shell">
      <section class="workspace" aria-labelledby="page-title">
        <div class="intro">
          <p class="eyebrow">MVP en preparacion</p>
          <h1 id="page-title">Song Repertoire App</h1>
          <p>
            Un espacio para gestionar canciones, letras, categorias y repertorios
            musicales desde una aplicacion web moderna.
          </p>
        </div>

        <div class="panel" aria-label="Modulos previstos">
          {
            plannedFeatures.map((feature) => (
              <article>
                <span aria-hidden="true"></span>
                <h2>{feature}</h2>
              </article>
            ))
          }
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  :root {
    color: #18212f;
    background: #f6f8fb;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
  }

  body {
    margin: 0;
    min-width: 320px;
  }

  .app-shell {
    min-height: 100vh;
    display: grid;
    align-items: center;
    padding: 32px clamp(18px, 4vw, 64px);
    box-sizing: border-box;
  }

  .workspace {
    width: min(1080px, 100%);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.9fr);
    gap: clamp(24px, 5vw, 72px);
    align-items: center;
  }

  .eyebrow {
    margin: 0 0 12px;
    color: #3f6f6b;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  h1,
  h2,
  p {
    margin-top: 0;
  }

  h1 {
    margin-bottom: 20px;
    font-size: clamp(2.4rem, 7vw, 5rem);
    line-height: 0.98;
    letter-spacing: 0;
  }

  .intro p:last-child {
    max-width: 620px;
    margin-bottom: 0;
    color: #4d5b6c;
    font-size: clamp(1rem, 2vw, 1.25rem);
    line-height: 1.65;
  }

  .panel {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  article {
    min-height: 128px;
    border: 1px solid #d7dde6;
    border-radius: 8px;
    background: #ffffff;
    padding: 18px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 16px 36px rgb(28 39 53 / 8%);
  }

  article span {
    width: 28px;
    height: 4px;
    border-radius: 999px;
    background: #c25743;
  }

  h2 {
    margin-bottom: 0;
    color: #243043;
    font-size: 1.05rem;
    line-height: 1.25;
  }

  @media (max-width: 760px) {
    .app-shell {
      align-items: start;
      padding-top: 48px;
    }

    .workspace {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .panel {
      grid-template-columns: 1fr;
    }
  }
</style>
